# =========================
# LOCAL DEVELOPMENT VALUES
# =========================
NODE_ENV=development
APP_NAME=media-admin-backend
APP_RUNTIME=http
PORT=10000
HTTP_BIND_HOST=0.0.0.0

# =========================
# HTTP / NETWORK
# =========================
TRUST_PROXY=1
# Comma-separated. Local frontend defaults to Vite port 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://media-frontend-kappa.vercel.app

# =========================
# DATABASE
# =========================
MONGO_DB_NAME=media_local
MONGO_MAX_POOL_SIZE=20
# Explicit dev/diagnostic-only startup measurement control.
# Default false: normal startup creates/verifies DB indexes.
# Production/deployed runtimes reject true.
SKIP_DB_INDEX_BOOTSTRAP=false
MONGO_URI=mongodb://localhost:27017/media_local

# =========================
# REDIS
# =========================
REDIS_URL=redis://localhost:6379

# =========================
# QUEUE / RESILIENCE
# =========================
QUEUE_BACKLOG_THRESHOLD=500
WORKER_CRASH_WINDOW_MS=300000
WORKER_CRASH_THRESHOLD=3
SYSTEM_METRICS_PORT=9464

# =========================
# AUTH0
# =========================
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.local.example

# Optional: only set if Auth0 Management API integration is enabled.
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
#
# Required for admin/HR account provisioning and password setup.
# If any value below is missing, provisioning fails closed at runtime.
# AUTH0_MANAGEMENT_DOMAIN=your-tenant.auth0.com
# AUTH0_MANAGEMENT_CLIENT_ID=
# AUTH0_MANAGEMENT_CLIENT_SECRET=
# AUTH0_DATABASE_CONNECTION=Username-Password-Authentication
# AUTH0_PASSWORD_SETUP_RESULT_URL=https://admin.local.example/password-ready

# =========================
# LOCAL-ONLY MOCK AUTH
# =========================
# Disabled by default. This accepts only Authorization: Bearer mock-access-token
# for local fullstack smoke/dev when explicitly enabled.
# Never enable in production, staging, Render, Vercel, Railway, Fly, Heroku, or any deployed runtime.
# Auth0 config is still required for HTTP runtime; this does not replace Auth0.
LOCAL_MOCK_AUTH_ENABLED=false
LOCAL_MOCK_AUTH_ACTOR_ID=local-mock-admin-actor
# LOCAL_MOCK_AUTH_EMAIL=local-admin@example.test
# Required and explicit when LOCAL_MOCK_AUTH_ENABLED=true. Keep local smoke permissions read-only.
# LOCAL_MOCK_AUTH_PERMISSIONS=user:view,role:list,role:view,role:assignment:view,orgUnit.read,employmentProfile.read,talent.read,talentGroup.read,platformAccount.read,studioResource.read,workSchedule.read,event.read,contractRegistry.read,talentKpi.read,revenueLedger.read,commissionRule.read,commissionSettlement.read,dashboardLite.read
# Optional JSON ActorScopeGrants. Grant global only for current global-only read/list modules.
# LOCAL_MOCK_AUTH_SCOPE_GRANTS={"workSchedule":["self","team","department"],"eventAssignment":["global"],"contractRegistry":["global"],"talentKpi":["global"],"revenueLedger":["global"],"commission":["global"],"dashboardLite":["global"]}

# =========================
# SECRETS - NEVER COMMIT REAL VALUES
# =========================
ENCRYPTION_KEY=<64_HEX_ENCRYPTION_KEY>
# AUTH0_CLIENT_SECRET=<AUTH0_CLIENT_SECRET>
# AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>

# =========================
# LOGGING
# =========================
LOG_LEVEL=info

# =========================
# STORAGE
# =========================
STORAGE_PROVIDER=local
STORAGE_BASE_URL=http://localhost:10000

# =========================
# STORAGE SIGNED URL POLICY
# =========================
STORAGE_UPLOAD_TTL=300
STORAGE_DOWNLOAD_TTL=300

# =========================
# RENDER PRODUCTION/STAGING VALUES
# =========================
# Set deployed environment values in the Render dashboard, not in this file.
# Use the deployed backend URL for STORAGE_BASE_URL when STORAGE_PROVIDER=local.
# Use Render/VPC/private service URLs for MONGO_URI and REDIS_URL where applicable.
# Configure production CORS_ORIGINS with deployed frontend origins only.

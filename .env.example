# =========================
# APP / ENV
# =========================
NODE_ENV=development
APP_NAME=
APP_RUNTIME=http
PORT=
HTTP_BIND_HOST=0.0.0.0

# =========================
# HTTP / NETWORK
# =========================
TRUST_PROXY=1
CORS_ORIGINS=

# =========================
# DATABASE
# =========================
MONGO_DB_NAME=
MONGO_MAX_POOL_SIZE=20
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# =========================
# REDIS
# =========================
REDIS_URL=rediss://default:<password>@<host>:<port>

# Nếu Redis Cloud yêu cầu TLS thì đổi dòng trên thành:
# REDIS_URL=rediss://default:<REDIS_PASSWORD>@redis-17374.crce178.ap-east-1-1.ec2.cloud.redislabs.com:17374

# =========================
# QUEUE / RESILIENCE
# =========================
QUEUE_BACKLOG_THRESHOLD=500
WORKER_CRASH_WINDOW_MS=300000
WORKER_CRASH_THRESHOLD=3
SYSTEM_METRICS_PORT=9464

# =========================
# AUTH0
# =========================
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=

# Không cần nếu chưa dùng Auth0 Management API
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# =========================
# SECURITY
# =========================
ENCRYPTION_KEY=<64_HEX_ENCRYPTION_KEY>

# =========================
# LOGGING
# =========================
LOG_LEVEL=info

# =========================
# STORAGE
# =========================
STORAGE_PROVIDER=local
STORAGE_BASE_URL=

# =========================
# STORAGE SIGNED URL POLICY
# =========================
STORAGE_UPLOAD_TTL=300
STORAGE_DOWNLOAD_TTL=300